{
  "name": "bp-mui-date-range-picker",
  "version": "2.0.0",
  "description": "Date range input for React, themed with CSS custom properties and slot classes, designed to sit inside someone else’s design system",
  "license": "MIT",
  "author": "f1eeman <mr.f1eeman@gmail.com>",
  "repository": "https://github.com/f1eeman/bp-mui-date-range-picker.git",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config playground/vite.config.ts",
    "typecheck:react18": "tsc --noEmit -p tsconfig.react18.json",
    "verify": "npm run typecheck && npm run typecheck:react18 && npm test",
    "docs:tokens": "node scripts/tokens.ts",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "date-fns": "^4.1.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "clsx": "^2.1.1",
    "react-day-picker": "^9.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "date-fns": "^4.1.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.5",
    "types-react-18": "npm:@types/react@^18.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
